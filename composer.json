{
    "name": "onpayio/php-sdk",
    "type": "library",
    "description": "PHP SDK for OnPay.io API",
    "homepage": "https://github.com/onpayio/php-sdk",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "OnPay\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "nyholm/psr7": "^1.0"
    }
}
